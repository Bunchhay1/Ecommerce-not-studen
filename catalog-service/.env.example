# Server
SERVER_PORT=8002
ENVIRONMENT=development

# Security / Shared JWT Secret
JWT_SECRET=development-secret-key-change-in-production-never-commit-real-secrets

# PostgreSQL Database (catalog_db)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=catalog_db
DB_USER=postgres
DB_PASSWORD=password

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=

# Kafka Broker
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=false
