PORT=8088
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8088

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5439
POSTGRES_DB=payment_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
ConnectionStrings__DefaultConnection=Host=localhost;Port=5439;Database=payment_db;Username=postgres;Password=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6386
Redis__ConnectionString=localhost:6386

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9099
Kafka__BootstrapServers=localhost:9099
Kafka__Topic=payment.events

# JWT
JWT_SECRET=supersecretjwtkeyforidentityservice2026ecommerceplatform
Jwt__Secret=supersecretjwtkeyforidentityservice2026ecommerceplatform
Jwt__Issuer=auth-service
Jwt__Audience=ecommerce-marketplace

# Payment Providers (Mock / Stripe / PayPal)
Payment__Provider=MOCK
Payment__Stripe__SecretKey=sk_test_mock
Payment__Stripe__WebhookSecret=whsec_mock
Payment__PayPal__ClientId=mock_client_id
Payment__PayPal__ClientSecret=mock_client_secret
