PORT=8089
NODE_ENV=development

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5440/shipping_db?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6387
REDIS_PASSWORD=

# Kafka
KAFKA_BROKERS=localhost:9100
KAFKA_CLIENT_ID=shipping-service
KAFKA_GROUP_ID=shipping-service-group
KAFKA_TOPIC_SHIPPING_EVENTS=shipping.events

# JWT Authentication
JWT_SECRET=supersecretjwtkeyforidentityservice2026ecommerceplatform

# Shipping Providers
SHIPPING_DEFAULT_CARRIER=LOCAL
DHL_API_KEY=mock_dhl_key
DHL_WEBHOOK_SECRET=whsec_dhl_mock
FEDEX_API_KEY=mock_fedex_key
FEDEX_WEBHOOK_SECRET=whsec_fedex_mock
UPS_API_KEY=mock_ups_key
UPS_WEBHOOK_SECRET=whsec_ups_mock
