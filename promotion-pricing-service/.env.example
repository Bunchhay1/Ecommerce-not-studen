# Promotion / Pricing Service Configuration
PROJECT_NAME=promotion-pricing-service
ENVIRONMENT=development
PORT=8090
LOG_LEVEL=INFO

# Database - PostgreSQL
DATABASE_URL=postgresql+asyncpg://pricing_user:pricing_password@localhost:5441/pricing_db

# Redis Cache
REDIS_URL=redis://localhost:6388/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9101
KAFKA_PROMOTION_TOPIC=promotion.events
KAFKA_CATALOG_TOPIC=catalog.events

# Security & JWT
JWT_SECRET=supersecretjwtkeyforpromotionandpricingservice2026
JWT_ALGORITHM=HS256

# Outbox Publisher
OUTBOX_POLL_INTERVAL_SECONDS=2
