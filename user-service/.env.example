# Server Configuration
PORT=8001
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Security & JWT (Shared with Auth Service)
JWT_SECRET=development-secret-key-change-in-production-never-commit-real-secrets

# PostgreSQL Database (User DB)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=user_db
DB_SSLMODE=disable

# Redis Cache (Optional / Recommended)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL_MINUTES=30

# Kafka Broker (Optional / Scaffolded)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_USER_EVENTS=user.events
KAFKA_ENABLED=false
