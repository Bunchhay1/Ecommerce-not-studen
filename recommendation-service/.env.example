# Application
PROJECT_NAME="Recommendation Service"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8093
LOG_LEVEL="INFO"

# Security
SECRET_KEY="recommendation-secret-key-change-in-production-never-commit-real-secrets"
ALGORITHM="HS256"

# Database (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://recommendation_user:recommendation_password@localhost:5444/recommendation_db"

# Redis Cache
REDIS_URL="redis://localhost:6391/0"
CACHE_TTL_RECOMMENDATIONS=3600
CACHE_TTL_SIMILAR_PRODUCTS=21600
CACHE_TTL_TRENDING=1800

# Kafka Broker & Topics
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
KAFKA_GROUP_ID="recommendation-service-group"
KAFKA_RECOMMENDATION_EVENTS_TOPIC="recommendation.events"
KAFKA_CATALOG_EVENTS_TOPIC="catalog.product.events"
KAFKA_ORDER_EVENTS_TOPIC="order.events"
KAFKA_REVIEW_EVENTS_TOPIC="review.events"
KAFKA_INTERACTION_EVENTS_TOPIC="user.interaction.events"
