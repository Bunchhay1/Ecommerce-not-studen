# Service Configuration
APP_NAME=search-service
APP_ENV=development
DEBUG=true
PORT=8084
HOST=0.0.0.0

# OpenSearch
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX_NAME=products_v1
OPENSEARCH_INDEX_ALIAS=products

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6382
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL_SEARCH_SECONDS=300
CACHE_TTL_AUTOCOMPLETE_SECONDS=600

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9095
KAFKA_GROUP_ID=search-service-group
KAFKA_PRODUCT_EVENTS_TOPIC=catalog.product.events
KAFKA_CATEGORY_EVENTS_TOPIC=catalog.category.events
KAFKA_BRAND_EVENTS_TOPIC=catalog.brand.events
KAFKA_CATALOG_EVENTS_TOPIC=catalog-events

# PostgreSQL (Metadata & Synonyms)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5435/search_db
DB_ECHO=false

# Security & JWT
JWT_SECRET_KEY=development-secret-key-change-in-production-never-commit-real-secrets
JWT_ALGORITHM=HS256

# Catalog Service Internal URL (for on-demand reindexing / fetching)
CATALOG_SERVICE_URL=http://localhost:8083
