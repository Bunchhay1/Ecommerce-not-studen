# Service Configuration
PORT=8085
NODE_ENV=development
APP_NAME=cart-service

# PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5436/cart_db?schema=public"

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6383
REDIS_PASSWORD=
REDIS_DB=0
CART_CACHE_TTL_SECONDS=3600

# Kafka
KAFKA_BROKERS=localhost:9096
KAFKA_CLIENT_ID=cart-service
KAFKA_GROUP_ID=cart-service-group
KAFKA_CART_EVENTS_TOPIC=cart.events

# Security & JWT
JWT_SECRET=development-secret-key-change-in-production-never-commit-real-secrets

# Catalog Service URL
CATALOG_SERVICE_URL=http://localhost:8083

# Inventory Service URL
INVENTORY_SERVICE_URL=http://localhost:8086
