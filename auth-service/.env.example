PROJECT_NAME="Auth Service"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Security
SECRET_KEY="supersecretkey-change-in-production-use-a-long-random-string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Origins (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:8080"]

# PostgreSQL Database
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="auth_db"
# Optional direct async DB URI override:
# SQLALCHEMY_DATABASE_URI="postgresql+asyncpg://postgres:password@localhost:5432/auth_db"
